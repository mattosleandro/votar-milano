# URL pública da instância Supabase Self-Hosted (ex.: https://api.portalmilano.com)
NEXT_PUBLIC_SUPABASE_URL=https://api.portalmilano.com

# Chave pública anônima (anon key) da instância Supabase Self-Hosted
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui

# Senha interna de 10 caracteres para proteger o console da Mesa Diretora (/admin)
# Importante: mantenha entre aspas por conter o caractere especial '#'
NEXT_PUBLIC_ADMIN_PIN="M1l@no#26A"

# URL pública oficial para geração do QR Code no /telao
NEXT_PUBLIC_APP_URL=https://votar.portalmilano.com
